# Copy this file to a private server-side location and edit the absolute paths.
# Do not place API keys here. Qwen API settings are unrelated to this NPU run.

PROJECT_ROOT=/home/ma-user/work/competition
MINDSPEED_MM_ROOT=/home/ma-user/work/competition/third_party/MindSpeed-MM
PYTHON_BIN=python3

# Use the actual CANN path exposed by the selected ModelArts image.
CANN_ENV=/usr/local/Ascend/cann/set_env.sh
ASCEND_DEVICE_ID=0
MASTER_ADDR=127.0.0.1
MASTER_PORT=6000

# Downloaded Qwen/Qwen3.5-0.8B Hugging Face-format directory.
QWEN35_HF_DIR=/home/ma-user/work/weights/Qwen3.5-0.8B
# Output of scripts/convert_qwen35_weights.sh.
QWEN35_DCP_DIR=/home/ma-user/work/weights/Qwen3.5-0.8B-dcp
# Official validation annotation file, normally annotations_slim.json.
QWEN35_DATASET=/home/ma-user/work/datasets/qwen35/annotations_slim.json

QWEN35_NUM_WORKERS=8
